# FailEcho configuration. Copy to .env or export these in your service unit.
# Every value here is a safe placeholder -- never commit real secrets.

# ---- public identity -------------------------------------------------------
# The canonical public origin. Drives canonical/OG tags, /llms.txt, robots.txt
# and every example rendered on the homepage. This is the ONLY place the
# production domain belongs.
FIN_PUBLIC_URL=http://localhost:8000

# Repository URL. While unset, no GitHub link is rendered anywhere.
# FIN_GITHUB_URL=

# ---- storage ---------------------------------------------------------------
# SQLite for the prototype. Four slashes = absolute path.
FIN_DATABASE_URL=sqlite+aiosqlite:///./data/failure_network.db

# ---- privacy ---------------------------------------------------------------
# GENERATE ONCE, KEEP FOREVER:  openssl rand -hex 16
# Regenerating this resets every reporter hash and every unique-reporter count.
# Never commit the real value.
FIN_REPORTER_SALT=change-me-generate-with-openssl-rand-hex-16

# ---- demo ------------------------------------------------------------------
# 1 only for a demonstration instance. Production runs 0.
FIN_DEMO_MODE=0

# ---- deployment ------------------------------------------------------------
# Enable ONLY behind a reverse proxy that sets the forwarded header. On a
# directly exposed server this lets any client forge its rate-limit identity.
FIN_TRUST_PROXY=0
FIN_ALLOWED_ORIGINS=*

# ---- tuning (defaults shown) -----------------------------------------------
FIN_RETENTION_HOURS=48
FIN_RATE_LIMIT_WRITES_PER_MINUTE=120
FIN_MAX_REPORTER_WEIGHT_PER_HOUR=5
FIN_MIN_UNIQUE_REPORTERS=3
FIN_MIN_RECOVERY_ATTEMPTS=5
FIN_MIN_RECOVERY_SUCCESS_RATE=0.60
