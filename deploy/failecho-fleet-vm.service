# One persona, one run, then exit. Chosen round-robin by the module from its
# state file. The timer is the loop.
[Unit]
Description=FailEcho fleet test, VM lane (one builder or OpenCode run)
After=network-online.target failecho-lab.service failecho-sandbox-proxy.service
Wants=network-online.target failecho-sandbox-proxy.service
# Wants, not Requires: a lab restart (every re-pin) must not kill a run
# in flight; a run whose reports fail is a run that reports failed=N.
Wants=failecho-lab.service

[Service]
Type=oneshot
User=failecho
Group=failecho
WorkingDirectory=/srv/failecho-lab/app
# provider keys only; deliberately NOT /etc/failecho.env -- the fleet refuses
# to start if an operator token is present, and that is the point
EnvironmentFile=/etc/failecho-agent.env
Environment="FAILECHO_ENDPOINT=http://127.0.0.1:8089"
Environment="FLEET_LAB_DB=/srv/failecho-lab/data/lab.db"
Environment="FLEET_MAX_RUNS_PER_DAY=3000"
# what the sandbox guest reports to, through the fence; the public lab URL
# because the guest cannot see this host's loopback
Environment="FLEET_LAB_PUBLIC_URL=https://lab.failecho.com"
Environment="FAILECHO_SANDBOX_RUN=/run/failecho-sandbox"
Environment="FAILECHO_SANDBOX_SCRATCH=/var/lib/failecho-sandbox-scratch"
ExecStart=/srv/failecho/.venv/bin/python -m failecho_fleet --lane vm
TimeoutStartSec=540
# a builder run holds one 384 MiB microVM; every other persona is ~40 MB
# the VM lane: a builder's 384 MB guest or OpenCode's 768 MB one (a bun
# binary is killed in 384); the guest's resident pages count against this unit
MemoryMax=1100M
StateDirectory=failecho-fleet failecho-sandbox-scratch
RuntimeDirectory=failecho-sandbox
RuntimeDirectoryPreserve=yes
ReadOnlyPaths=/srv/failecho-lab/data
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
