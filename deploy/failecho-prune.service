[Unit]
Description=Prune raw observations of FailEcho

[Service]
Type=oneshot
User=failecho
Group=failecho
WorkingDirectory=/srv/failecho
Environment="FIN_DATABASE_URL=sqlite+aiosqlite:////srv/failecho/data/failure_network.db"
Environment="FIN_RETENTION_HOURS=48"
ExecStart=/srv/failecho/.venv/bin/python /srv/failecho/scripts/prune.py
ProtectSystem=strict
# strict also makes /tmp read-only, and SQLite needs a temp file for a
# large GROUP BY: the lab's first prune died on it with "disk I/O error"
# (23 Sep). Production only worked because its database is still small.
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/srv/failecho/data
