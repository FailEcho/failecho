# FailEcho -- TLS termination and reverse proxy.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically. The app
# itself listens only on 127.0.0.1:8000 and never faces the internet directly.

failecho.com {
	encode zstd gzip

	# --- security headers ---------------------------------------------------
	# There were none. Everything below is a default a browser will apply if
	# it is told to and will not if it is not.
	header {
		# A year of HTTPS-only, subdomains included. Not preloaded: that is a
		# one-way door and belongs to a deliberate decision, not to a config
		# tidy-up.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# The site loads no third-party anything -- the API reference's Swagger
		# bundle is served from /static/vendor for exactly this reason -- so
		# the policy can say 'self' and mean it. No inline script: the only
		# inline block on any page is application/ld+json, which is data.
		# connect-src also names the lab, our own second instance: the home
		# page reads its fleet.json for the with-vs-without rows. Reads only,
		# same software, same operator; still not 'self', so it is listed.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://lab.failecho.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"

		# A JSON response that a browser decides is HTML is an XSS.
		X-Content-Type-Options "nosniff"
		# frame-ancestors covers this for anything modern; this is for the rest.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here needs a camera, a microphone or a location.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Caddy announces itself by default.
		-Server
	}

	# The application refuses anything over 16KB by Content-Length. A chunked
	# body has no length to refuse, so the limit is also set here, where the
	# connection can be cut before the bytes reach a worker with a 400MB
	# ceiling. 64KB rather than 16KB: this one is the backstop, and it should
	# not be the thing that rejects a legitimate request first.
	# OTLP batches are the one exception: many spans per request, capped at
	# 256KB in the application and here.
	@otlp path /v1/otlp/*
	request_body @otlp {
		max_size 320KB
	}
	request_body {
		max_size 64KB
	}

	# Static brand assets and the stylesheet change rarely.
	@static path /static/*
	header @static Cache-Control "public, max-age=3600"

	# Per-request endpoints must never be cached: each answer belongs to one
	# caller and one failure.
	@live path /v1/query /v1/observe /v1/outcome /health /mcp
	header @live Cache-Control "no-store"

	# The three read-only endpoints the homepage polls are a different case.
	# Every visitor asks for the same network-wide numbers every 30s, so a
	# 10-second edge cache collapses a launch-day crowd into a handful of
	# origin queries. Ten seconds of staleness is invisible on a dashboard
	# that refreshes every thirty.
	@dashboard path /v1/stats /v1/services /v1/recovery-intelligence
	header @dashboard Cache-Control "public, max-age=10"

	# Crawl surfaces: short TTL. Cloudflare defaults .txt and .xml to four
	# hours, which would keep serving a stale robots.txt or sitemap long after
	# a deploy changed it.
	@crawl path /robots.txt /sitemap.xml /llms.txt
	header @crawl Cache-Control "public, max-age=300"

	# /favicon.ico has no version string to bust, and Cloudflare caches .ico
	# for four hours by default -- long enough that a corrected favicon stays
	# invisible in search results. One hour, so a fix propagates the same day.
	@icon path /favicon.ico
	header @icon Cache-Control "public, max-age=3600"

	reverse_proxy 127.0.0.1:8000 {
		# A restart takes a second or two. Retry across it rather than handing
		# a visitor a 502: every 502 this site has served was a deploy.
		lb_try_duration 8s
		lb_try_interval 250ms
	}

	log {
		output file /var/log/caddy/failecho.log {
			roll_size 10MiB
			roll_keep 5
		}
		# The site promises it never stores headers or credentials, and the
		# default access log stores every one of them: X-FailEcho-Operator,
		# Authorization and X-Reporter-ID were all sitting here in the clear,
		# outside the hashing the application does. Method, URI, status and
		# duration are what an access log is for; the headers are not.
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>tls delete
			}
		}
	}
}

www.failecho.com {
	redir https://failecho.com{uri} permanent
}

# The lab. A second instance for the fleet test, labelled as such on every
# page. Nothing here is the public network. See docs/fleet-test-plan.md.
lab.failecho.com {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:8089 {
		lb_try_duration 8s
		lb_try_interval 250ms
	}
}
