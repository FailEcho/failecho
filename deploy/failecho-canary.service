# The install canary: every advertised install path, from a clean VM, once a
# day. See failecho_sandbox/canary.py. A failing step fails the unit, so
# `systemctl --failed` and the scoreboard both show it.
[Unit]
Description=FailEcho install canary (clean-VM install of every package)
After=network-online.target failecho-sandbox-proxy.service failecho-lab.service
Wants=network-online.target failecho-sandbox-proxy.service
# Wants, not Requires: a lab restart (every re-pin) must not kill a run
# in flight; a run whose reports fail is a run that reports failed=N.
Wants=failecho-lab.service

[Service]
Type=oneshot
User=failecho
Group=failecho
WorkingDirectory=/srv/failecho-lab/app
Environment="CANARY_LAB_URL=https://lab.failecho.com"
Environment="FAILECHO_SANDBOX_RUN=/run/failecho-sandbox"
Environment="FAILECHO_SANDBOX_SCRATCH=/var/lib/failecho-sandbox-scratch"
ExecStart=/srv/failecho/.venv/bin/python -m failecho_sandbox canary
TimeoutStartSec=900
MemoryMax=600M
StateDirectory=failecho-fleet failecho-sandbox-scratch
RuntimeDirectory=failecho-sandbox
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
