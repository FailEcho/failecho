# Every two hours, offset from the fleet's two-minute grid; eight models in
# rotation, so each one is tried about every 16 hours.
[Unit]
Description=FailEcho onboarding test, every two hours

[Timer]
OnCalendar=*-*-* 00/2:20:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
