# systemd unit for FailEcho.
#
#   sudo cp deploy/failure-network.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now failure-network
#
# Adjust User, WorkingDirectory and the paths below to match your VPS.

[Unit]
Description=FailEcho
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=failurenet
Group=failurenet
WorkingDirectory=/srv/failure-network

# One worker: SQLite serialises writes anyway, and the in-process rate limiter
# and MCP session manager are per-process. Scale up only after Postgres.
ExecStart=/srv/failure-network/.venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers \
    --forwarded-allow-ips '127.0.0.1' --no-server-header

Environment="FIN_DATABASE_URL=sqlite+aiosqlite:////srv/failure-network/data/failure_network.db"
# Only enable when a reverse proxy actually sets the forwarded header.
Environment="FIN_TRUST_PROXY=1"
Environment="FIN_RATE_LIMIT_WRITES_PER_MINUTE=120"
Environment="FIN_RETENTION_HOURS=48"
Environment="FIN_ALLOWED_ORIGINS=*"
Environment="FIN_DEMO_MODE=0"
# Canonical public origin: drives canonical/OG tags, /llms.txt and every
# example rendered on the homepage. The only place the domain is written.
Environment="FIN_PUBLIC_URL=https://failecho.com"
# Leave unset until the repository is public; no GitHub link renders while
# it is empty.
# Environment="FIN_GITHUB_URL=https://github.com/ORG/REPO"

# FIN_REPORTER_SALT lives here, generated ONCE and never regenerated:
#   printf 'FIN_REPORTER_SALT=%s\n' "$(openssl rand -hex 16)" \
#     | sudo tee /etc/failure-network.env > /dev/null
#   sudo chmod 600 /etc/failure-network.env
# Regenerating it on every start would reset every reporter hash.
EnvironmentFile=/etc/failure-network.env

Restart=always
RestartSec=2

# Modest hardening; the service needs nothing but its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/failure-network/data
MemoryMax=400M

[Install]
WantedBy=multi-user.target
