# One persona, one run, then exit. Chosen round-robin by the module from its
# state file. The timer is the loop.
[Unit]
Description=FailEcho fleet test (one persona run)
After=network-online.target failecho-lab.service
Wants=network-online.target
Requires=failecho-lab.service

[Service]
Type=oneshot
User=failecho
Group=failecho
WorkingDirectory=/srv/failecho
# provider keys only; deliberately NOT /etc/failecho.env -- the fleet refuses
# to start if an operator token is present, and that is the point
EnvironmentFile=/etc/failecho-agent.env
Environment="FAILECHO_ENDPOINT=http://127.0.0.1:8089"
Environment="FLEET_LAB_DB=/srv/failecho-lab/data/lab.db"
Environment="FLEET_MAX_RUNS_PER_DAY=600"
ExecStart=/srv/failecho/.venv/bin/python -m failecho_fleet
TimeoutStartSec=180
MemoryMax=120M
StateDirectory=failecho-fleet
ReadOnlyPaths=/srv/failecho-lab/data
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
