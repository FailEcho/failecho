# The VM lane: one builder or OpenCode persona a minute (every two until 2026-09-18 21:00 UTC); a run that
# takes longer holds the slot (systemd starts no second instance) and the
# light lane keeps going meanwhile. Since 2026-09-18 13:30 UTC.
[Unit]
Description=FailEcho fleet test, VM lane, one persona a minute

[Timer]
OnCalendar=*:0/1
RandomizedDelaySec=15
Persistent=false

[Install]
WantedBy=timers.target
